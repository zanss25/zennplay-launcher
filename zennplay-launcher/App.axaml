<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="zennplay_launcher.App"
             xmlns:local="using:zennplay_launcher"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://zennplay-launcher/Themes/ColorSchemes/ObsidianPurple.axaml" />
                <ResourceInclude Source="avares://zennplay-launcher/Themes/FontSchemes/Default.axaml" />

                <ResourceInclude Source="avares://zennplay-launcher/Views/Controls/PropertyInputView.axaml" />
                <ResourceInclude Source="avares://zennplay-launcher/Views/Controls/MultiSelectComboBox.axaml" />
                <ResourceInclude Source="avares://zennplay-launcher/Views/Controls/PropertyMultiSelectComboBoxView.axaml" />
                <ResourceInclude Source="avares://zennplay-launcher/Views/Controls/OptionHeaderView.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://zennplay-launcher/Themes/DefaultUIStyles.axaml"/>
    </Application.Styles>

</Application>