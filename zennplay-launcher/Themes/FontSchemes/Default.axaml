<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontLogo">Segoe UI</FontFamily>
    <FontFamily x:Key="FontTitle">Segoe UI</FontFamily>
    <FontFamily x:Key="FontPrimary">./Assets/Fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="FontSidebar">./Assets/Fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="FontCommon">Segoe UI</FontFamily>

</ResourceDictionary>
