<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:viewmodels="using:zennplay_launcher.ViewModels"
             xmlns:views="using:zennplay_launcher.Views"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.SectionView"
             x:DataType="viewmodels:SectionViewModel">
  
    <Grid>
        <controls:AppListControl IsVisible="{Binding !IsViewingDetail}"/>
        <controls:AppDetailControl IsVisible="{Binding IsViewingDetail}"/>
    </Grid>

</UserControl>
