<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:zennplay_launcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.TitleBarView">
  
    <Grid Height="38" ColumnDefinitions="*, Auto" Background="Transparent" Margin="0,2,0,0"
          VerticalAlignment="Top" PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
          
        <Rectangle Grid.Column="0" Fill="Transparent"/>

        <StackPanel x:Name="TitleBarButtons" Orientation="Horizontal" 
                    Grid.Row="0" Grid.Column="1" Margin="5"
                    IsVisible="{Binding ShowButtons, RelativeSource={RelativeSource AncestorType=local:TitleBarView}}">
                    
            <Button Content="—" Click="MinimizeBtn_Click" Classes="ControlButton"
                    WindowDecorationProperties.ElementRole="MinimizeButton"
                    IsVisible="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=local:TitleBarView}}"/>
                    
            <Button Content="☐" Click="MaximizeBtn_Click" Classes="ControlButton"
                    WindowDecorationProperties.ElementRole="MaximizeButton"
                    IsVisible="{Binding ShowMaximizeButton, RelativeSource={RelativeSource AncestorType=local:TitleBarView}}"/>
                    
            <Button Content="✕" Click="CloseBtn_Click" Classes="ControlButton"
                    WindowDecorationProperties.ElementRole="CloseButton"
                    IsVisible="{Binding ShowCloseButton, RelativeSource={RelativeSource AncestorType=local:TitleBarView}}"/>
        </StackPanel>

    </Grid>

</UserControl>