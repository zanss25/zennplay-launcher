<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:zennplay_launcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:zennplay_launcher.Models"
        xmlns:views="using:zennplay_launcher.Views"
        mc:Ignorable="d"
        MinWidth="1100" MinHeight="670"
        d:DesignWidth="1100" d:DesignHeight="670"
        x:Class="zennplay_launcher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/zenn-icon.ico"
        Title="ZennPlay"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        
        ExtendClientAreaToDecorationsHint="True"  
        ExtendClientAreaTitleBarHeightHint="-1" 
        WindowDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Main Window Background -->
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Background>
            <RadialGradientBrush Center="75%,45%" 
                                 GradientOrigin="70%,75%" 
                                 RadiusX="180%" 
                                 RadiusY="175%">
                <GradientStop Color="{DynamicResource MainWindowBackgroundB}" Offset="0.0"/>    
                <GradientStop Color="{DynamicResource MainWindowBackgroundA}" Offset="1.0"/>
            </RadialGradientBrush>
        </Border.Background>
        
        <Grid RowDefinitions="Auto, *">
            
            <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" MinHeight="70" 
                               MaxHeight="100" Margin="0,-2,0,0" IsHitTestVisible="False">

                <DockPanel.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource BarBackGradientA}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BarBackGradientB}" Offset="1"/>
                    </LinearGradientBrush>
                </DockPanel.Background>

            </DockPanel>

            <!-- Title Bar -->
            <views:TitleBarView Grid.Row="0"/>

            <!-- Contents --> 
            <Grid Grid.RowSpan="2" ColumnDefinitions="Auto, *">

                <!-- Sidebar -->
                <views:SidebarView Grid.Column="0" />

                <!-- Content Slot -->
                <Grid Grid.Column="1" RowDefinitions="Auto, *">
                    <ContentControl Grid.Row="1"
                                    x:Name="ContentSlot" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch"
                                    Content="{Binding CurrentView}">

                    </ContentControl>
                </Grid>

            </Grid>
        </Grid>
    </Border>

</Window>