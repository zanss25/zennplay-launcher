<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:zennplay_launcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:zennplay_launcher.Models"
        mc:Ignorable="d"
        MinWidth="1100" MinHeight="670"
        d:DesignWidth="1100" d:DesignHeight="670"
        x:Class="zennplay_launcher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/zenn-icon.ico"
        Title="ZennPlay"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        
        ExtendClientAreaToDecorationsHint="True"  
        ExtendClientAreaTitleBarHeightHint="-1" 
        WindowDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Background>
            <RadialGradientBrush Center="75%,45%" 
                                 GradientOrigin="70%,75%" 
                                 RadiusX="180%" 
                                 RadiusY="175%">
                <GradientStop Color="{DynamicResource MainWindowBackgroundB}" Offset="0.0"/>
    
                <GradientStop Color="{DynamicResource MainWindowBackgroundA}" Offset="1.0"/>
            </RadialGradientBrush>
        </Border.Background>
        
        <Grid RowDefinitions="Auto, *">
            
            <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" MinHeight="70" 
                               MaxHeight="100" Margin="0,-2,0,0" IsHitTestVisible="False">

                <DockPanel.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource BarBackGradientA}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BarBackGradientB}" Offset="1"/>
                    </LinearGradientBrush>
                </DockPanel.Background>

            </DockPanel>

            <Grid Grid.Row="0" Height="38" ColumnDefinitions="*, Auto" Background="Transparent" Margin="0,2,0,0"
                    VerticalAlignment="Top" PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
                <Rectangle Grid.Column="0" Fill="Transparent"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsVisible="False">
                    <Button x:Name="MinimizeBtn" Classes="ControlButton" Click="MinimizeBtn_Click"
                            Content="─" FontSize="16" Width="45" Height="32" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button x:Name="MaximizeBtn" Classes="ControlButton" 
                            Content="□" FontSize="16" Width="45" Height="32" Click="MaximizeBtn_Click"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CloseBtn" Classes="ControlButton" 
                            Content="✕" FontSize="16" Width="45" Height="32" Click="CloseBtn_Click"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.RowSpan="2" ColumnDefinitions="Auto, *">
                
                <Border Grid.Column="0" 
                        Width="220"
                        Background="#20000000"
                        BorderBrush="{DynamicResource BorderCommonBrush}"
                        BorderThickness="0,0,1,0">
                    
                    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
                        
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,0,0,20">
                            <TextBlock Text="ZENN" 
                                       Grid.Column="0" 
                                       Classes="LogoText" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="1" 
                                    Content="☰" 
                                    Classes="ControlButton" 
                                    FontSize="16" 
                                    Background="Transparent"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="15">
                                
                                <ListBox x:Name="SidebarSections"
                                         Classes="ListBoxPrimary"
                                         ItemsSource="{Binding Sections}"
                                         SelectedItem="{Binding SelectedSection}"
                                         Background="Transparent" 
                                         BorderBrush="Transparent">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:SectionModel"> 
                                            <StackPanel>                                                               
                                                <TextBlock Text="{Binding Name}"/> 
                                            </StackPanel>  
                                        </DataTemplate> 
                                    </ListBox.ItemTemplate> 

                                </ListBox>

                                <Separator Background="{DynamicResource BorderCommonBrush}" Margin="4,0"/>

                                <ListBox x:Name="SidebarTabs"
                                         Classes="ListBoxPrimary"
                                         Background="Transparent" 
                                         BorderBrush="Transparent">
                                    <ListBoxItem Classes="ListItemPrimary">Library</ListBoxItem> 
                                    <ListBoxItem Classes="ListItemPrimary">Relics</ListBoxItem> 
                                    <ListBoxItem Classes="ListItemPrimary">Boards</ListBoxItem> 
                                </ListBox>

                            </StackPanel>
                        </ScrollViewer>

                        <Button x:Name="SettingsBtn"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                FontSize="13"
                                Content="Settings"
                                Padding="10,8"/>

                    </Grid>
                </Border>


                <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="15,30,15,0">

                    <Border Grid.Row="0" Padding="20,15,20,15">
                        <Grid ColumnDefinitions="Auto, Auto, *, Auto"
                              MaxHeight="30">
                            
                            <TextBox Grid.Column="0" 
                                     Width="260"
                                     PlaceholderText="🔍 Search.." 
                                     Classes="TextBox"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sort by" VerticalAlignment="Center" Foreground="{DynamicResource TextWindowBrush}" FontSize="13"/>
                                <ComboBox SelectedIndex="0" Classes="ComboBox" Width="140">
                                    <ComboBoxItem Content="Alphabetical"/>
                                    <ComboBoxItem Content="Last Played"/>
                                    <ComboBoxItem Content="Rating"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3" 
                                    Content="+ Add Game" 
                                    Classes="ButtonPrimary" 
                                    VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>


                    <Border Grid.Row="1" Padding="20,0,20,20">
                        <ContentControl x:Name="ContentSlot" 
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch">
                        </ContentControl>
                    </Border>

                </Grid>

            </Grid>

        </Grid>
    </Border>

</Window>