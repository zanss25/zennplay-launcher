<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:zennplay_launcher.Views.Controls">

    <Design.PreviewWith>
        <StackPanel Width="400" Spacing="10">
            <StackPanel Background="{DynamicResource SystemRegionBrush}">
                <controls:PropertyDirectoryInputView />
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:PropertyDirectoryInputView}" TargetType="controls:PropertyDirectoryInputView">
        <Setter Property="Template">
            <ControlTemplate>

                <Grid ColumnDefinitions="130, *" VerticalAlignment="Center" Margin="0,0,0,12">
                    
                    <TextBlock Grid.Column="0" 
                               Text="{TemplateBinding Label}" 
                               Classes="TextPropertiesLabel"
                               VerticalAlignment="Center"/>

                    <controls:DirectoryInputView Grid.Column="1"
                                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                                 PlaceholderText="{TemplateBinding PlaceholderText}"
                                                 BrowseCommand="{TemplateBinding BrowseCommand}"/>
                </Grid>

            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
