<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:zennplay_launcher.Views.Controls">

    <ControlTheme x:Key="{x:Type controls:PropertySwitchTextView}"
                  TargetType="controls:PropertySwitchTextView">
        <Setter Property="Template">
            <ControlTemplate>
                
                <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,0,0,12">
                    
                    <ToggleSwitch Grid.Column="0"
                                  OnContent="" OffContent=""
                                  IsChecked="{TemplateBinding IsChecked, Mode=TwoWay}"/>

                    <TextBlock Grid.Column="1" 
                               Text="{TemplateBinding Label}" 
                               Classes="TextPropertiesLabel"
                               VerticalAlignment="Center"/>

                </Grid>

            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
