<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:zennplay_launcher.Models"
                    xmlns:controls="using:zennplay_launcher.Views.Controls">

    <Design.PreviewWith>
        <StackPanel Width="400" Height="400" Margin="20" Spacing="10" Background="{DynamicResource WindowBackgroundBrush}">
            <controls:MultiSelectComboBox PlaceholderText="Pilih atau ketik genres..." />
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:MultiSelectComboBox}"
                  TargetType="controls:MultiSelectComboBox">
        
        <!-- Nilai Default Properti Visual -->
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontCommon}"/>

        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- Input Bar Utama -->
                    <Border x:Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="32">
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     Text="{TemplateBinding Text, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8,5"
                                     VerticalContentAlignment="Center"/>

                            <ToggleButton x:Name="PART_DropDownToggle"
                                          Grid.Column="1"
                                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Width="30"
                                          Focusable="False"
                                          Cursor="Hand">
                                <PathIcon Data="M7 10l5 5 5-5z"
                                          Width="10"
                                          Height="10"
                                          Foreground="{DynamicResource TextCommonBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- Popup Dropdown -->
                    <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding #PART_RootBorder}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        
                        <Border Background="{DynamicResource PopupBackgroundBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                MinWidth="{Binding #PART_RootBorder.Bounds.Width}"
                                Margin="0,4,0,0">
                            
                            <Grid RowDefinitions="Auto, Auto, *">
                                
                                <!-- BARIS 0: AREA ADD NEW (TOGGLE INLINE) -->
                                <Panel Grid.Row="0" Margin="0,0,0,4">
                                    
                                    <!-- State 1: Tombol Normal "+ Add New" -->
                                    <Button x:Name="PART_AddNewButton"
                                            Classes="ButtonPopup"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{Binding !IsAddingNew, RelativeSource={RelativeSource TemplatedParent}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource TextCommonActiveBrush}"/>
                                            <TextBlock Text="{TemplateBinding AddNewText}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- State 2: Box Input Mini -->
                                    <Grid ColumnDefinitions="*, Auto, Auto"
                                          IsVisible="{TemplateBinding IsAddingNew}">
                                        
                                        <TextBox x:Name="PART_NewItemTextBox"
                                                 Grid.Column="0"
                                                 PlaceholderText="New item name..."
                                                 FontSize="12"
                                                 Padding="6,3"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,4,0"/>

                                        <Button x:Name="PART_ConfirmAddButton"
                                                Grid.Column="1"
                                                Content="✓"
                                                Padding="6,3"
                                                Margin="0,0,2,0"/>

                                        <Button x:Name="PART_CancelAddButton"
                                                Grid.Column="2"
                                                Content="✕"
                                                Padding="6,3"/>
                                    </Grid>
                                </Panel>

                                <!-- Separator / Garis Batas -->
                                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource TextBoxBorderBrush}" Margin="0,2,0,4"/>

                                <!-- BARIS 2: LIST CHECKBOX -->
                                <ScrollViewer Grid.Row="2" MaxHeight="220">
                                    <ItemsControl x:Name="PART_ItemsControl"
                                                  ItemsSource="{TemplateBinding FilteredItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SelectableItem">
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="4,2"
                                                          HorizontalAlignment="Stretch"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Focus & Hover Trigger States -->
        <Style Selector="^:pointerover /template/ Border#PART_RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderHoverBrush}"/>
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1.1"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>