<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:zennplay_launcher.Views"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             xmlns:vmcontrols="using:zennplay_launcher.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.Controls.PropertiesMetadataView"
             x:DataType="vmcontrols:PropertiesMetadataViewModel">
  
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto">

            <!-- Details -->
            <StackPanel Grid.Row="0">
                <controls:OptionHeaderView Label="General"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyInputView Label="Title"/>
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Series"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Series"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Platforms"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Platform"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Developers"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Developer"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Publishers"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Publisher"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyInputView Label="Release Date"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,20,20,20">
                        <controls:PropertyInputView Label="Age Rating"/>
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Genres"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Series"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  Label="Tags"
                                  Contents="{Binding SelectedTagsText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableTags}"
                                  AddNewText="New Tag"
                                  AddNewCommand="{Binding OpenAddNewDialogCommand}"
                                  />
                        <controls:PropertyInputView Label="Source"/>
                        <controls:PropertyInputView Label="User Rating"/>
                    </StackPanel>
                    <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="20,0">
                        <controls:PropertyInputView Label="Description"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Other Details -->
            <StackPanel Grid.Row="1">
                <controls:OptionHeaderView Label="Other Details"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyInputView Label="Sorting Title"/>
                        <controls:PropertyInputView Label="Is Game"/>
                        <controls:PropertyInputView Label="Is Excluded"/>
                        <controls:PropertyInputView Label="Is Pinned"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,20,20,20">
                        <controls:PropertyInputView Label="First Launched"/>
                        <controls:PropertyInputView Label="Last Launched"/>
                        <controls:PropertyInputView Label="Launch Times"/>
                        <controls:PropertyInputView Label="Completion Status"/>
                    </StackPanel>
                    <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="20,0">
                        <controls:PropertyInputView Label="Notes"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Section Options -->
            <StackPanel Grid.Row="2">
                <controls:OptionHeaderView Label="Section Options"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyInputView Label="Section"/>
                        <controls:PropertyInputView Label="Is Game"/>
                        <controls:PropertyInputView Label="Is Excluded"/>
                        <controls:PropertyInputView Label="Is Pinned"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>  
    </ScrollViewer>

</UserControl>
