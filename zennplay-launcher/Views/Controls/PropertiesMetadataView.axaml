<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:zennplay_launcher.Views"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             xmlns:vmcontrols="using:zennplay_launcher.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.Controls.PropertiesMetadataView"
             x:DataType="vmcontrols:PropertiesMetadataViewModel">
  
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto">

            <!-- Details -->
            <StackPanel Grid.Row="0">
                <controls:OptionHeaderView Label="General"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyInputView x:Name="TitleInput"
                                                    Label="Title"
                                                    Text="{Binding Title}"/>
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="SeriesInput"
                                  Label="Series"
                                  Contents="{Binding SelectedSeriesText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableSeries}"
                                  AddNewText="New Series"
                                  AddNewCommand="{Binding AddSeriesCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="PlatformsInput"
                                  Label="Platforms"
                                  Contents="{Binding SelectedPlatformsText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailablePlatforms}"
                                  AddNewText="New Platform"
                                  AddNewCommand="{Binding AddPlatformCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="DevelopersInput"
                                  Label="Developers"
                                  Contents="{Binding SelectedDevelopersText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableDevelopers}"
                                  AddNewText="New Developer"
                                  AddNewCommand="{Binding AddDeveloperCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="PublishersInput"
                                  Label="Publishers"
                                  Contents="{Binding SelectedPublishersText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailablePublishers}"
                                  AddNewText="New Publisher"
                                  AddNewCommand="{Binding AddPublisherCommand}"
                                  />
                        <controls:PropertyCalendarTextInputView x:Name="ReleaseDateInput"
                                                                Label="Release Date"
                                                                Text="{Binding ReleaseDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,20,20,20">
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="AgeRatingsInput"
                                  Label="Age Ratings"
                                  Contents="{Binding SelectedAgeRatingsText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableAgeRatings}"
                                  AddNewText="New Age Rating"
                                  AddNewCommand="{Binding AddAgeRatingCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="GenresInput"
                                  Label="Genres"
                                  Contents="{Binding SelectedGenresText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableGenres}"
                                  AddNewText="New Series"
                                  AddNewCommand="{Binding AddGenreCommand}"
                                  />
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="TagsInput"
                                  Label="Tags"
                                  Contents="{Binding SelectedTagsText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableTags}"
                                  AddNewText="New Tag"
                                  AddNewCommand="{Binding AddTagCommand}"
                                  />
                        <controls:PropertyDropdownView x:Name="SourceInput"
                                                       Label="Source"
                                                       ItemsSource="{Binding AvailableSources}"
                                                       SelectedItem="{Binding SelectedSource}"/>
                        <controls:PropertyInputView x:Name="UserRatingInput"
                                                    Label="User Rating"
                                                    Text="{Binding UserRating}"/>
                    </StackPanel>
                    <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="20,0">
                        <controls:PropertyLongInputView x:Name="DescriptionInput"
                                                        Label="Description"
                                                        Text="{Binding Description}"
                                                        InputMinHeight="150"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Section Options -->
            <StackPanel Grid.Row="1">
                <controls:OptionHeaderView Label="Section Options"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyMultiSelectComboBoxView 
                                  x:Name="SectionsInput"
                                  Label="Sections"
                                  Contents="{Binding SelectedSectionsText, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableSections}"
                                  AddNewText="New Section"
                                  AddNewCommand="{Binding AddSectionCommand}"
                                  />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Other Details -->
            <StackPanel Grid.Row="2">
                <controls:OptionHeaderView Label="Other Details"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*"
                      Grid.Row="1">
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                        <controls:PropertyInputView x:Name="SortingTitleInput"
                                                    Label="Sorting Title"
                                                    Text="{Binding SortingTitle}"/>
                        <controls:PropertyInputView x:Name="FirstLaunchedInput"
                                                    Label="First Launched"
                                                    Text="{Binding FirstLaunched}"
                                                    IsEnabled="False"/>
                        <controls:PropertyInputView x:Name="LastLaunchedInput"
                                                    Label="Last Launched"
                                                    Text="{Binding LastLaunched}"
                                                    IsEnabled="False"/>
                        <controls:PropertyInputView x:Name="LaunchTimesInput"
                                                    Label="Launch Times"
                                                    Text="{Binding LaunchTimes}"
                                                    IsEnabled="False"/>
                        <controls:PropertyDropdownView x:Name="CompletionStatusInput"
                                                       Label="Completion Status"
                                                       ItemsSource="{Binding AvailableCompletionStatuses}"
                                                       SelectedItem="{Binding SelectedCompletionStatus}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Grid.Row="0" Margin="0,20,20,20"
                                VerticalAlignment="Stretch">
                        <controls:PropertyLongInputView x:Name="NotesInput"
                                                        Label="Notes"
                                                        Text="{Binding Notes}"/>
                    </Grid>
                    <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="20,0">
                        <controls:PropertySwitchTextView x:Name="IsNotGameSwitch"
                                                         Label="Flag as non-game app"
                                                         IsChecked="{Binding IsNotGame}"/>
                        <controls:PropertySwitchTextView x:Name="IsExcludedSwitch"
                                                         Label="Exclude from stats"
                                                         IsChecked="{Binding IsExcluded}"/>
                        <controls:PropertySwitchTextView x:Name="IsPinnedSwitch"
                                                         Label="Pin to the top"
                                                         IsChecked="{Binding IsPinned}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>  
    </ScrollViewer>

</UserControl>
