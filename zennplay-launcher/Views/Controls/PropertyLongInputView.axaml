<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:zennplay_launcher.Views.Controls">

    <Design.PreviewWith>
        <StackPanel Width="400" Spacing="10">
            <StackPanel Background="{DynamicResource SystemRegionBrush}">
                <controls:PropertyLongInputView />
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:PropertyLongInputView}" TargetType="controls:PropertyLongInputView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="130, *" RowDefinitions="*" VerticalAlignment="Stretch" Margin="0,0,0,12">
                    
                    <TextBlock Grid.Column="0" 
                               Text="{TemplateBinding Label}" 
                               Classes="TextPropertiesLabel"
                               VerticalAlignment="Top"
                               Margin="0,4"/>

                    <TextBox Grid.Column="1" 
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             PlaceholderText="{TemplateBinding PlaceholderText}"
                             MinHeight="{TemplateBinding InputMinHeight}"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    
</ResourceDictionary>
