<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             xmlns:converters="using:zennplay_launcher.Converters"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:viewmodels="using:zennplay_launcher.ViewModels"
             xmlns:views="using:zennplay_launcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.Controls.SectionGridView"
             x:DataType="viewmodels:SectionViewModel">
  
    <ScrollViewer x:Name="MainScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    
        <Grid HorizontalAlignment="Center">
            <ItemsControl ItemsSource="{Binding DisplayedApps}" HorizontalAlignment="Left"
                          Margin="20,5">
        
                <!-- 1. Jadikan WrapPanel sebagai panel pengatur tata letak kartu -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- 2. Template per item kartu game -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:AppModel">
                
                        <Viewbox Width="160" Stretch="Uniform">
                            <Button Margin="5" 
                                    Padding="2" 
                                    Background="#1AFFFFFF" 
                                    CornerRadius="4"
                                    Width="200"
                                    Height="300"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">

                                <Grid>
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource FontCommon}" FontSize="20" FontWeight="DemiBold"
                                               TextWrapping="Wrap"/>
                                    <Image Source="{Binding CoverPath, Converter={x:Static converters:BitmapAssetValueConverter.Instance}}" 
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch" 
                                           VerticalAlignment="Stretch"/>
                                </Grid>

                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="LAUNCH"
                                                  CommandParameter="{Binding}"
                                                  Classes="MenuItemPrimary"
                                                  FontWeight="DemiBold"/>
                                        <MenuItem Header="Pin to the Top"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Add to >"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Customize >"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Browse Folder"
                                                  Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).OpenAppFolderCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Properties"
                                                  Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).EditAppCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Soft Delete"
                                                  Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).SoftDeleteAppCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Hard Delete" 
                                                  Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).HardDeleteAppCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="* * * * *"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                            </Button>
                        </Viewbox>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        
            </ItemsControl>
        </Grid>
        
    </ScrollViewer>

</UserControl>
