<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:zennplay_launcher.Views.Controls">

    <ControlTheme x:Key="{x:Type controls:PropertyMultiSelectComboBoxView}" TargetType="controls:PropertyMultiSelectComboBoxView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="130, *" VerticalAlignment="Center" Margin="0,0,0,12">
                    
                    <!-- Label Kiri -->
                    <TextBlock Grid.Column="0" 
                               Text="{TemplateBinding Label}" 
                               FontFamily="{DynamicResource FontCommon}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextCommonBrush}"
                               FontSize="13"/>

                    <controls:MultiSelectComboBox Grid.Column="1"
                                Text="{TemplateBinding Contents}"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                AddNewText="{TemplateBinding AddNewText}"
                                AddNewCommand="{TemplateBinding AddNewCommand}"
                                PlaceholderText="{TemplateBinding PlaceholderText}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>