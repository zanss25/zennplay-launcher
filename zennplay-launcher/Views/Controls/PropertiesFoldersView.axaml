<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:zennplay_launcher.Views"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             xmlns:vmcontrols="using:zennplay_launcher.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.Controls.PropertiesFoldersView"
             x:DataType="vmcontrols:PropertiesFoldersViewModel">
  
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto">

            <!-- Folders -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <StackPanel Grid.ColumnSpan="2">
                    <controls:OptionHeaderView Label="Folders"/>
                    <StackPanel Margin="20">
                        <controls:PropertyDirectoryInputView x:Name="InstallationFolderInput"
                                                             Label="Installation Folder"
                                                             Text="{Binding InstallationFolder, Mode=TwoWay}"
                                                             BrowseCommand="{Binding BrowseFolderCommand}"/>
                        
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <controls:PropertySwitchTextView x:Name="IsInstalledSwitch"
                                                                 Label="Is Installed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Classes="TextPropertiesLabel"
                                               Text="Install Size"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InstallSizeText"
                                               Classes="TextPropertiesLabel"
                                               VerticalAlignment="Center"
                                               Margin="80,0,0,0"
                                               Text="{Binding InstallSizeText}"/>
                                    <Button Margin="20,0,0,0"
                                            Content="Calculate"/>
                                    <Button Margin="5,0,0,0"
                                            Content="Input Manually"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>     

            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="1">
                <controls:OptionHeaderView Label="Actions"/>
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                    <controls:EditableListView ActionButtonText="Edit"/>
                </StackPanel>
            </StackPanel>

            <!-- Links -->
            <StackPanel Grid.Row="2">
                <controls:OptionHeaderView Label="Links"/>
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="20">
                    <controls:EditableListView ActionButtonText="Edit"/>
                </StackPanel>
            </StackPanel>

        </Grid>  
    </ScrollViewer>

</UserControl>
