<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:zennplay_launcher.Views.Controls"
             xmlns:converters="using:zennplay_launcher.Converters"
             xmlns:models="using:zennplay_launcher.Models"
             xmlns:viewmodels="using:zennplay_launcher.ViewModels"
             xmlns:views="using:zennplay_launcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="zennplay_launcher.Views.Controls.SectionListView"
             x:DataType="viewmodels:SectionViewModel">
  
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DisplayedApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:AppModel">
                        
                    <!--    <Border Background="Transparent"
                                xmlns:i="using:Avalonia.Xaml.Interactivity"
                                xmlns:ia="using:Avalonia.Xaml.Interactions.Core">
                            <i:Interaction.Behaviors>
                                <ia:EventTriggerBehavior EventName="DoubleTapped">
                                    <ia:InvokeCommandAction 
                                        Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).LaunchAppCommand}"
                                        CommandParameter="{Binding}" />
                                </ia:EventTriggerBehavior>
                            </i:Interaction.Behaviors>

                            
                        </Border> -->

                        <Button Margin="10,5" 
                                Padding="12" 
                                Background="#1AFFFFFF" 
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).ShowAppDetailCommand}">

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image Source="{Binding IconPath, Converter={x:Static converters:BitmapAssetValueConverter.Instance}}" 
                                            Height="32" Width="32" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontCommon}"
                                                FontSize="15" FontWeight="Regular" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Pinned" FontFamily="{DynamicResource FontCommon}" FontSize="14" Foreground="{DynamicResource TextCommonBrush}"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding IsPinned}"/>
                                    <Button Content="|>" Margin="10,0,0,0"/>
                                    <Button Content=":" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="LAUNCH"
                                                CommandParameter="{Binding}"
                                                Classes="MenuItemPrimary"
                                                FontWeight="DemiBold"/>
                                    <MenuItem Header="Toggle Pin to Top"
                                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).PinAppCommand}"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Add to >"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Customize >"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Browse Folder"
                                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).OpenAppFolderCommand}"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Properties"
                                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).EditAppCommand}"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Soft Delete"
                                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).SoftDeleteAppCommand}"
                                                CommandParameter="{Binding}"/>
                                    <MenuItem Header="Hard Delete" 
                                                Command="{Binding $parent[UserControl].((viewmodels:SectionViewModel)DataContext).HardDeleteAppCommand}"
                                                CommandParameter="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="* * * * *"/>
                                </ContextMenu>
                            </Button.ContextMenu>

                        </Button>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

</UserControl>
