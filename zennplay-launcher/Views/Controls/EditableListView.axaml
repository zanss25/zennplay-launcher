<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:zennplay_launcher.Views.Controls"
                    xmlns:models="using:zennplay_launcher.Models">

    <ControlTheme x:Key="{x:Type controls:EditableListView}" TargetType="controls:EditableListView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*, Auto">
                    
                    <!-- 1. CONTAINER UTAMA LIST -->
                    <Grid Grid.Row="0">
                        <ListBox x:Name="PART_ListBox"
                                 ItemsSource="{TemplateBinding ItemsSource}"
                                 SelectedItem="{TemplateBinding SelectedItem, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 MinHeight="180">
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:IEditableListItem">
                                    <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto" 
                                          Margin="4,2" 
                                          Background="Transparent">
                                        
                                        <!-- Grip Handle -->
                                        <TextBlock Grid.Column="0"
                                                   Text="⠿"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextCommonBrush}"
                                                   Opacity="0.5"
                                                   Cursor="SizeAll"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <!-- Ikon Action -->
                                        <Image Grid.Column="1"
                                               Source="{Binding DisplayIcon}"
                                               Width="18"
                                               Height="18"
                                               Margin="0,0,10,0"
                                               IsVisible="{Binding DisplayIcon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               VerticalAlignment="Center"/>

                                        <!-- Nama Action -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   FontFamily="{DynamicResource FontCommon}"
                                                   Foreground="{DynamicResource TextCommonBrighterBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>

                                        <!-- Target / Path -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DisplayValue}"
                                                   FontFamily="{DynamicResource FontCommon}"
                                                   Foreground="{DynamicResource TextCommonBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,8,0"
                                                   Opacity="0.75"/>

                                        <!-- Tombol Edit -->
                                        <Button Grid.Column="4"
                                                Content="Edit"
                                                Command="{Binding $parent[controls:EditableListView].EditCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0"/>

                                        <!-- Tombol Remove -->
                                        <Button Grid.Column="5"
                                                Content="Remove"
                                                Command="{Binding $parent[controls:EditableListView].RemoveCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 2. FLOATING GHOST CARD (Menempel Mengikuti Kursor) -->
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="PART_GhostOverlay"
                                    IsVisible="False"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource TextBoxBorderActiveBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Opacity="0.85"
                                    BoxShadow="0 4 12 0 #55000000">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⠿" FontSize="14" Foreground="{DynamicResource TextCommonActiveBrush}"/>
                                    <TextBlock x:Name="PART_GhostText" Text="Action Name" FontWeight="SemiBold" FontSize="13"
                                               FontFamily="{DynamicResource FontCommon}"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>

                    <!-- TOOLBAR BAWAH -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Content="{TemplateBinding AddText}"
                                Command="{TemplateBinding AddCommand}"/>
                    </Grid>

                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>